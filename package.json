{
  "name": "nexus-capital-engine",
  "version": "0.2.0",
  "private": true,
  "description": "NEXUS Capital & Opportunity Intelligence Platform",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "dev": "npm run build && node dist/runtime/main.js",
    "start": "node dist/runtime/main.js",
    "db:migrate": "npm run build && node dist/runtime/migrate.js",
    "etoro:observe-demo": "npm run build && node dist/broker/etoro/etoro-observe-cli.js",
    "etoro:map-instrument": "npm run build && node dist/broker/etoro/etoro-map-instrument-cli.js",
    "registry:inspect": "npm run build && node dist/market-data/registry-inspect-cli.js",
    "research:run": "node --max-old-space-size=512 dist/research/research-main.js",
    "research:status": "node dist/research/research-status-cli.js",
    "research:migrate": "node dist/research/research-migrate.js",
    "test": "vitest run --project unit --project pg",
    "test:unit": "vitest run --project unit",
    "test:pg": "vitest run --project pg",
    "test:live": "vitest run --project live",
    "bench": "vitest run --project bench",
    "test:watch": "vitest --project unit",
    "check": "npm run typecheck && npm run test",
    "check:fast": "npm run typecheck && vitest run --project unit && echo NOT A COMPLETE CHECK: PostgreSQL integration tests were not run. Full check: npm run check"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "embedded-postgres": "17.10.0-beta.17",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "pg": "8.23.1"
  }
}
