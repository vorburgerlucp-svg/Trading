TRADING_MODE=paper
ALLOW_LIVE_TRADING=false
MAX_POSITION_CHF=50
MAX_DAILY_LOSS_CHF=25
MIN_SIGNAL_CONFIDENCE=0.70
MIN_RISK_REWARD=1.50

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Gemini adapter not implemented yet (server-side only, never in the browser)
GEMINI_API_KEY=
ETORO_API_KEY=
ETORO_USER_KEY=

# Market data (server-side only; sent as Authorization header, never in URLs, logs or the browser).
# Without a key the Twelve Data provider is simply not configured (DATA NOT CONNECTED); no fake data.
TWELVE_DATA_API_KEY=

# PostgreSQL for the financial core and audit (server-side environment only, never commit a value).
# Apply migrations from db/migrations/ explicitly (npm run db:migrate); there is no automatic schema sync.
DATABASE_URL=

# Local runtime (npm run dev). Loopback by default; a non-loopback HOST exposes the API to the network: do not do that without a reviewed reason.
HOST=127.0.0.1
PORT=3000
# 1 = Twelve Data's public demo key (labelled demo, never usable for trading). Ignored when TWELVE_DATA_API_KEY is set.
NEXUS_TWELVE_DATA_DEMO=0

# IBKR read-only sync (O19). Off by default. The local Client Portal Gateway must run and be logged in on this machine.
# No IBKR credential is stored here: the gateway holds the login. The base URL must be loopback HTTPS with the /v1/api path.
# IBKR_CA_CERT_PATH is optional: a PEM file with the gateway's own certificate. Verification stays on either way.
# IBKR_ALLOW_BROKERAGE_INIT=1 lets a sync start the brokerage session when the gateway reports it as not ready. Keep it 0: a sync
# then stops with BROKER_BROKERAGE_INIT_REQUIRED and starts nothing. Set it to 1 only for one deliberate, supervised start.
# No value in this block can place, modify or cancel an order, and none can change the build locks.
IBKR_ENABLED=0
IBKR_BASE_URL=https://localhost:5000/v1/api
IBKR_ACCOUNT_ID=
IBKR_CA_CERT_PATH=
IBKR_ALLOW_BROKERAGE_INIT=0
