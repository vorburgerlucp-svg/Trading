# NEXUS R1 research environment (copy to .env.research in the research checkout; never commit the copy).
# The research instance REFUSES to start if any broker, trading, operator or production variable is present
# (ETORO_*, *BROKER*, NEXUS_OPERATOR_*, TRADING_MODE, ALLOW_LIVE_TRADING, DATABASE_URL, NEXUS_TWELVE_DATA_DEMO).
NEXUS_RESEARCH_DATABASE_URL=postgres://nexus_research_app:<password>@localhost:5432/nexus_research
TWELVE_DATA_API_KEY=<key>
NEXUS_RESEARCH_CATALOG_FILE=ops/research/research-catalog.example.json
# Without this line nothing is fetched or stored (license_not_cleared). Set it only after the documented owner decision on the
# Twelve Data terms (who, when, which terms version, which answer), e.g.:
# NEXUS_RESEARCH_DATA_CLEARANCE=TD terms 2026-01-01 + support answer <ref>; decided by <owner> on <date>
# Optional limits (defaults): daily 400 (max 800), minute 6 (max 8), run 240 s, free memory 2048 MB, catch-up 24 h.
# NEXUS_RESEARCH_DAILY_CREDIT_LIMIT=400
# NEXUS_RESEARCH_MINUTE_CREDIT_LIMIT=6
